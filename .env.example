PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=

# 行情輪詢與快取
QUOTE_POLL_MS=5000
SSE_HEARTBEAT_MS=15000
CACHE_TTL_QUOTE_MS=3500
CACHE_TTL_SEARCH_MS=21600000
CACHE_TTL_CATALOG_MS=86400000
CATALOG_SYNC_ON_START=true

# 行情與基本面付費／授權來源（皆為選填）
FUGLE_API_KEY=
FINMIND_TOKEN=
ALLTICK_TOKEN=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=

# AI 研究引擎（至少設定一組即可；未設定時使用本機規則引擎）
AI_PROVIDER_ORDER=openai,gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SEC 要求可識別的 User-Agent，請填入產品名稱與聯絡信箱
SEC_USER_AGENT=AlphaLens Enterprise admin@example.com

# 僅供自動測試，正式使用請保持 0
ALPHALENS_TEST_MODE=0
